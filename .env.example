PORT=5555
# Listen address. Loopback by default (the dashboard exposes SSH + power controls);
# set to the host LAN IP or 0.0.0.0 to allow access from another machine.
BIND_HOST=127.0.0.1
LLM_PORT=8888
POLL_INTERVAL_GPU=2000
POLL_INTERVAL_CPU=2000
POLL_INTERVAL_NETWORK=2000
POLL_INTERVAL_STORAGE=5000
POLL_INTERVAL_LLM=2000
POLL_INTERVAL_BANDWIDTH=1000
# Optional: ssh -i path inside the container when the key is not a default OpenSSH name
# SSH_IDENTITY_FILE=/root/.ssh/id_ed25519

# ─── Local LLM runtime switching (server/localLlmSwitch.js) ───
# Deployment-private values live in .env (gitignored) — the server refuses to
# start the Local LLM panel when any of these is missing.
# Host user that owns the runtime scripts (runuser target on the dashboard host).
LOCAL_LLM_HOST_USER=<host-user>
# Home directory of that user (passed as HOME/USER/LOGNAME into the command shell).
LOCAL_LLM_HOST_HOME=/home/<host-user>
# Exact model IDs as reported by each runtime's /v1/models endpoint.
LOCAL_LLM_MODEL_DEEPSEEK=<deepseek-model-id>
LOCAL_LLM_MODEL_QWEN=<qwen-model-id>
LOCAL_LLM_MODEL_GLM=<glm-model-id>
LOCAL_LLM_MODEL_NVFP4=<nvfp4-model-id>
# Optional display labels shown in the UI (fallbacks: DeepSeek / Qwen / GLM / GLM NVFP4).
# LOCAL_LLM_LABEL_DEEPSEEK=DeepSeek V4 Flash
# LOCAL_LLM_LABEL_QWEN=Qwen3.8 Flash Next
# LOCAL_LLM_LABEL_GLM=GLM-5.3 Flash
# LOCAL_LLM_LABEL_NVFP4=GLM-5.3 Flash NVFP4
# Allowlisted lifecycle commands, executed on the dashboard host via nsenter.
LOCAL_LLM_CMD_STOP_DEEPSEEK="cd /path/to/deepseek-runtime && exec ./stop.sh"
LOCAL_LLM_CMD_START_DEEPSEEK="cd /path/to/deepseek-runtime && exec ./start.sh"
LOCAL_LLM_CMD_STOP_QWEN="cd /path/to/qwen-runtime && exec ./start.sh stop"
LOCAL_LLM_CMD_START_QWEN="cd /path/to/qwen-runtime && exec ./start.sh serve"
LOCAL_LLM_CMD_STOP_GLM="cd /path/to/glm-runtime && exec ./stop.sh"
LOCAL_LLM_CMD_START_GLM="cd /path/to/glm-runtime && exec ./start.sh"
LOCAL_LLM_CMD_STOP_NVFP4="cd /path/to/nvfp4-runtime && exec ./runtime.sh stop"
LOCAL_LLM_CMD_START_NVFP4="cd /path/to/nvfp4-runtime && exec ./runtime.sh start"
# Optional: comma-separated targets from {deepseek,qwen,glm,nvfp4} without auto-rollback
# LOCAL_LLM_DISABLE_ROLLBACK_TARGETS=

# Docker only: host path of the SSH key mounted for remote-Spark key auth
# (docker-compose.yml volume source).
# SPARKDASH_SSH_KEY=/home/<user>/.ssh/id_ed25519_custom
